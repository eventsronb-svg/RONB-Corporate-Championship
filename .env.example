NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking
# Use the Neon pooled connection string in production; keep sslmode=require.
# Development-only value. Replace this with a unique random secret before deployment.
COOKIE_SECRET=local-development-cookie-secret-change-before-production-2026
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_RECEIPTS_BUCKET=booking-private
S3_LOGOS_BUCKET=booking-public
S3_LOGOS_PUBLIC_URL=
RESEND_API_KEY=
EMAIL_FROM=Ronb Events <events@example.com>
# Exact merchant-provided bank/wallet QR payload. Never invent bank QR formats.
# Optional {amount} and {code} placeholders only if supported by your provider.
PAYMENT_QR_TEMPLATE=
PAYMENT_INSTRUCTIONS=Transfer the exact amount and enter the unique code in payment remarks.
PAYMENT_EXPIRY_MINUTES=1440
SEED_ADMIN_EMAIL=
