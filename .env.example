NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking
# Use the Neon pooled connection string in production; keep sslmode=require.
# Development-only value. Replace this with a unique random secret before deployment.
COOKIE_SECRET=local-development-cookie-secret-change-before-production-2026
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional password login. Generate a new password, at least 16 characters; no built-in defaults.
ADMIN_LOGIN_USERNAME=
ADMIN_LOGIN_PASSWORD=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_RECEIPTS_BUCKET=booking-private
S3_LOGOS_BUCKET=booking-public
S3_LOGOS_PUBLIC_URL=
S3_PLAYERPHOTOS_BUCKET=player-photos
RESEND_API_KEY=
EMAIL_FROM=Ronb Events <events@example.com>
# Bank account details shown to captains on the payment step.
PAYMENT_BANK_DETAILS=Bank Name: Nabil Bank
Branch: Teendhara
Account Name: Routine of Nepal Pvt. Ltd.
Account Number: 01701017503541
PAN Number: 6059939958
PAYMENT_INSTRUCTIONS=Transfer the exact amount to the bank account below and enter the unique code in payment remarks.
PAYMENT_EXPIRY_MINUTES=1440
SEED_ADMIN_EMAIL=
