{
  "name": "ronb-events-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "tsx --env-file-if-exists=.env src/worker-main.ts",
    "migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "seed": "tsx --env-file-if-exists=.env src/cli.ts seed",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "test:browser": "playwright test",
    "check:all": "npm run check && npm run test:postgres && npm run test:browser",
    "format": "prettier --write src tests scripts public *.json *.ts *.md .github/workflows/test.yml compose.yaml",
    "format:check": "prettier --check src tests scripts public *.json *.ts *.md .github/workflows/test.yml compose.yaml"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "fastify": "^5.12.4",
    "google-auth-library": "^11.0.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "resend": "^6.28.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
